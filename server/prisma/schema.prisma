generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  username                String    @unique
  email                   String    @unique
  displayName             String
  passwordHash            String
  googleSub               String?   @unique
  avatarUrl               String?
  bio                     String    @default("Hey there! I am on Kamand Chat.")
  roomCode                String?
  isRoomPrivate           Boolean   @default(true)
  role                    String    @default("member") // member | moderator | admin | super_admin
  isSuspended             Boolean   @default(false)
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  wrappedPrivateKeyBackup String?
  backupSalt              String?
  backupIv                String?
  lastSeenAt              DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  sessions                Session[]
  devices                 Device[]
  faceTemplates           FaceTemplate[]
  faceChallenges          FaceChallenge[]
  memberships             Membership[]
  sentMessages            Message[]          @relation("SentMessages")
  readReceipts            ReadReceipt[]
  contactsInitiated       Contact[]          @relation("ContactRequester")
  contactsReceived        Contact[]          @relation("ContactTarget")
  statuses                Status[]
  statusViews             StatusView[]
  communityMembers        CommunityMember[]
  createdInvites          Invite[]
  joinRequests            JoinRequest[]
  senderKeysSent          GroupSenderKey[]   @relation("SenderKeyOwner")
  senderKeysReceived      GroupSenderKey[]   @relation("SenderKeyRecipient")
  callsInitiated          CallLog[]
  auditLogs               AuditLog[]

  @@index([username])
  @@index([email])
  @@index([displayName])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  csrfToken  String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName        String
  identityPublicKey String
  signingPublicKey  String
  keyFingerprint    String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model GroupSenderKey {
  id               String       @id @default(uuid())
  conversationId   String
  senderId         String
  recipientId      String
  generation       Int          @default(1)
  wrappedSenderKey String
  nonce            String
  createdAt        DateTime     @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation("SenderKeyOwner", fields: [senderId], references: [id], onDelete: Cascade)
  recipient        User         @relation("SenderKeyRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderId, recipientId, generation])
  @@index([conversationId, recipientId])
}

model FaceTemplate {
  id                   String   @id @default(uuid())
  userId               String
  deviceId             String
  deviceName           String
  encryptedEmbedding   String
  embeddingIv          String
  faceSigningPublicKey String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model FaceChallenge {
  id        String    @id @default(uuid())
  userId    String
  deviceId  String
  challenge String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@index([expiresAt])
}

model Contact {
  id          String   @id @default(uuid())
  requesterId String
  targetId    String
  status      String   @default("pending") // pending | accepted | blocked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("ContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User     @relation("ContactTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
  @@index([requesterId, status])
}

model Conversation {
  id                  String           @id @default(uuid())
  type                String           @default("direct") // direct | group
  directPairKey       String?          @unique
  title               String?
  lastSeq             Int              @default(0)
  senderKeyGeneration Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  memberships         Membership[]
  messages            Message[]
  channel             Channel?
  senderKeys          GroupSenderKey[]
  callLogs            CallLog[]

  @@index([updatedAt])
}

model Membership {
  id               String       @id @default(uuid())
  conversationId   String
  userId           String
  role             String       @default("member")
  lastReadSeq      Int          @default(0)
  lastDeliveredSeq Int          @default(0)
  joinedAt         DateTime     @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id                  String        @id
  conversationId      String
  senderId            String
  body                String
  ciphertext          String?
  nonce               String?
  senderKeyGeneration Int?
  type                String        @default("text")
  replyToId           String?
  threadRootId        String?
  seq                 Int
  status              String        @default("sent")
  editedAt            DateTime?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())

  conversation        Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo             Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies             Message[]     @relation("MessageReplies")
  threadRoot          Message?      @relation("MessageThread", fields: [threadRootId], references: [id], onDelete: Cascade)
  threadReplies       Message[]     @relation("MessageThread")
  readReceipts        ReadReceipt[]

  @@unique([conversationId, seq])
  @@index([conversationId, seq])
  @@index([threadRootId, seq])
  @@index([senderId])
}

model CallLog {
  id             String       @id
  conversationId String
  initiatorId    String
  mediaType      String       @default("audio") // audio | video
  isGroup        Boolean      @default(false)
  status         String       @default("ringing") // ringing | ongoing | completed | declined | busy | missed
  durationSec    Int          @default(0)
  startedAt      DateTime     @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator      User         @relation(fields: [initiatorId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt])
  @@index([initiatorId])
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model Status {
  id             String       @id @default(uuid())
  authorId       String
  caption        String
  mediaDataUrl   String?
  bgColor        String       @default("#0284c7")
  visibility     String       @default("contacts")
  allowedUserIds String       @default("[]")
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views          StatusView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StatusView {
  id       String   @id @default(uuid())
  statusId String
  viewerId String
  viewedAt DateTime @default(now())

  status   Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@index([statusId])
  @@index([viewerId])
}

model Community {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String            @default("")
  isPrivate    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  members      CommunityMember[]
  categories   Category[]
  channels     Channel[]
  invites      Invite[]
  joinRequests JoinRequest[]

  @@index([slug])
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  userId      String
  role        String    @default("member")
  isMuted     Boolean   @default(false)
  isPinned    Boolean   @default(false)
  isArchived  Boolean   @default(false)
  joinedAt    DateTime  @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId])
}

model Category {
  id          String    @id @default(uuid())
  communityId String
  name        String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channels    Channel[]

  @@index([communityId, position])
}

model Channel {
  id             String                      @id @default(uuid())
  communityId    String
  categoryId     String
  conversationId String                      @unique
  name           String
  topic          String                      @default("")
  type           String                      @default("text")
  position       Int                         @default(0)
  isPinned       Boolean                     @default(false)
  isArchived     Boolean                     @default(false)
  createdAt      DateTime                    @default(now())

  community      Community                   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category       Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  overrides      ChannelPermissionOverride[]

  @@index([categoryId, position])
  @@index([communityId])
}

model ChannelPermissionOverride {
  id        String  @id @default(uuid())
  channelId String
  role      String
  canView   Boolean @default(true)
  canSend   Boolean @default(true)

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, role])
  @@index([channelId])
}

model Invite {
  id          String    @id @default(uuid())
  code        String    @unique
  communityId String
  creatorId   String
  uses        Int       @default(0)
  maxUses     Int?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([communityId])
}

model JoinRequest {
  id          String    @id @default(uuid())
  communityId String
  userId      String
  status      String    @default("pending")
  note        String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
