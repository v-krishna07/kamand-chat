generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  username            String    @unique
  email               String    @unique
  displayName         String
  passwordHash        String
  avatarUrl           String?
  bio                 String    @default("Hey there! I am on Kamand Chat.")
  roomCode            String?
  isRoomPrivate       Boolean   @default(true)
  role                String    @default("member") // member | moderator | admin | super_admin
  isSuspended         Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastSeenAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions            Session[]
  devices             Device[]
  memberships         Membership[]
  sentMessages        Message[]      @relation("SentMessages")
  contactsInitiated   Contact[]      @relation("ContactRequester")
  contactsReceived    Contact[]      @relation("ContactTarget")
  auditLogs           AuditLog[]

  @@index([username])
  @@index([email])
  @@index([displayName])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  csrfToken  String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName        String
  identityPublicKey String
  signingPublicKey  String
  createdAt         DateTime @default(now())

  @@index([userId])
}

model Contact {
  id          String   @id @default(uuid())
  requesterId String
  targetId    String
  status      String   @default("pending") // pending | accepted | blocked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("ContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User     @relation("ContactTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
  @@index([requesterId, status])
}

model Conversation {
  id          String       @id @default(uuid())
  type        String       @default("direct") // direct | group
  directPairKey String?    @unique            // "<smallerUserId>:<largerUserId>" for idempotent 1:1 creation
  title       String?
  lastSeq     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  messages    Message[]

  @@index([updatedAt])
}

model Membership {
  id                 String       @id @default(uuid())
  conversationId     String
  userId             String
  role               String       @default("member") // owner | admin | moderator | member
  lastReadSeq        Int          @default(0)
  lastDeliveredSeq   Int          @default(0)
  joinedAt           DateTime     @default(now())

  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id // Client-generated UUID v4 for idempotent sends
  conversationId String
  senderId       String
  body           String
  ciphertext     String?
  nonce          String?
  type           String       @default("text") // text | image | voice | file | system
  replyToId      String?
  seq            Int
  status         String       @default("sent") // sent | delivered | read
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")

  @@unique([conversationId, seq])
  @@index([conversationId, seq])
  @@index([senderId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
